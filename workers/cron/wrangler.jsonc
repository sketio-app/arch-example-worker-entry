{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "entry-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entry-notes",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
